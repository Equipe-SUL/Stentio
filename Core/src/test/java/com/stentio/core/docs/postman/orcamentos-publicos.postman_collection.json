{
  "info": {
    "name": "Stentio - Orçamentos Públicos",
    "description": "Executar seed-orcamentos-dev.sql antes de cada rodada; a coleção consome os tokens demonstrativos. Não requer JWT.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8082"
    },
    {
      "key": "token_aprovar",
      "value": "6bbd9908-4783-4991-a4f9-b0fc1807115a"
    },
    {
      "key": "token_rejeitar",
      "value": "6bbd9908-4783-4991-a4f9-b0fc1807115b"
    },
    {
