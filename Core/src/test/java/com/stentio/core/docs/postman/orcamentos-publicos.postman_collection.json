  ],
  "item": [
    {
      "name": "01 - Consultar orçamento (200)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/public/orcamentos?token={{token_aprovar}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
