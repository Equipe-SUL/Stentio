# File size limit: 10 MiB. The multipart envelope is not included.
MAX_UPLOAD_BYTES=10485760

# Resource import uses the Core API. In Docker's network use http://core:8082.
CORE_API_URL=http://localhost:8082
CORE_TIMEOUT_SECONDS=15
MAX_IMPORT_RESOURCES=100
MAX_IMPORT_ROWS=5000

# Database configuration (not used by the CSV preview endpoint yet).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stentio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_ECHO=false
