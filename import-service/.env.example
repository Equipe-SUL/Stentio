# Serviço executado no Windows; preserva os dados do .env que você já utiliza.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stentio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_pela_senha_do_seu_postgres
DATABASE_ECHO=false
LOGGER_LEVEL=INFO
MAX_UPLOAD_BYTES=10485760
MAX_IMPORT_ROWS=5000
MAX_IMPORT_RESOURCES=1000
CORS_ALLOWED_ORIGINS=["http://localhost","http://localhost:8080","http://localhost:19006","http://127.0.0.1","http://127.0.0.1:8080"]
