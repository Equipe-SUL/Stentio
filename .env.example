# Segredo comum usado para assinar e validar tokens; gere um valor aleatório antes de iniciar.
JWT_SECRET=CHANGE_ME
# Origens que podem acessar as APIs; informe URLs separadas por vírgula.
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8000,http://localhost:19006
# Padrões de origem aceitos pelo serviço Auth; informe padrões separados por vírgula.
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*
# Porta publicada no host para o serviço Auth; internamente ele usa 8080.
SERVER_PORT=8081
# Usuário HTTP Basic do Spring Security.
APP_SECURITY_USER=admin
# Senha HTTP Basic; substitua por um valor forte.
APP_SECURITY_PASSWORD=CHANGE_ME
# Ativa o cookie Secure; use true quando a aplicação estiver em HTTPS.
APP_COOKIE_SECURE=false
# Política SameSite do cookie; use None somente com HTTPS e APP_COOKIE_SECURE=true.
APP_COOKIE_SAME_SITE=Lax
# Cria o administrador inicial quando habilitado.
SEED_ADMIN_ENABLED=false
# E-mail do administrador inicial; usado somente quando SEED_ADMIN_ENABLED=true.
ADMIN_INITIAL_EMAIL=admin@stentio.com
# Senha do administrador inicial; obrigatória quando SEED_ADMIN_ENABLED=true.
ADMIN_INITIAL_PASSWORD=
# Porta publicada no host para o Core; internamente ele usa 8080.
CORE_SERVER_PORT=8082
# Banco opcional do Core; vazio usa POSTGRES_DB. Um banco separado deve existir previamente.
CORE_POSTGRES_DB=
# Versão inicial do Flyway Auth; use 0 em bancos novos.
AUTH_FLYWAY_BASELINE_VERSION=0
# Versão inicial do Flyway Core; use 0 em bancos novos.
CORE_FLYWAY_BASELINE_VERSION=0
# Insere dados de demonstração no Core.
SEED_TEST_DATA_ENABLED=false
# Habilita Swagger e OpenAPI no Core.
ENABLE_DOCS=false
# URL pública da página de aprovação de orçamento enviada ao cliente.
ORCAMENTO_URL_CONSULTA_PUBLICA=http://localhost/orcamento
# URL do portal enviada aos profissionais por e-mail.
PORTAL_RECURSO_URL=http://localhost/portal
# E-mail que recebe avisos operacionais.
EQUIPE_EMAIL=operacoes@stentio.local
# Validade do token de orçamento no formato de duração ISO-8601.
ORCAMENTO_TOKEN_VALIDADE=PT120H
# Habilita o processamento de notificações pela outbox.
ORCAMENTO_OUTBOX_ENABLED=true
# Intervalo entre tentativas de processamento da outbox, em milissegundos.
ORCAMENTO_OUTBOX_INTERVALO_MS=5000
# Intervalo para nova tentativa de envio, em segundos.
ORCAMENTO_OUTBOX_RETRY_SEGUNDOS=30
# Tempo máximo de espera por confirmação do RabbitMQ, em segundos.
ORCAMENTO_OUTBOX_CONFIRM_TIMEOUT_SEGUNDOS=5
# Diretório compartilhado de arquivos do Core e do serviço de e-mail.
APP_ARQUIVOS_DIRETORIO=/app/uploads
# Extensões permitidas para arquivos enviados, separadas por vírgula e sem ponto.
APP_ARQUIVOS_EXTENSOES=pdf,doc,docx,odt,rtf,txt,xls,xlsx,ppt,pptx,jpg,jpeg,png
# Número máximo de arquivos por solicitação.
APP_ARQUIVOS_MAXIMO=10
# Tamanho máximo de um arquivo enviado ao Core.
APP_ARQUIVO_TAMANHO_MAXIMO=10MB
# Tamanho máximo de uma requisição multipart ao Core.
APP_REQUISICAO_TAMANHO_MAXIMO=50MB
# Porta publicada no host para o serviço de e-mail.
EMAIL_SERVICE_PORT=8083
# URL interna usada pelo Core para chamar o serviço de e-mail.
EMAIL_SERVICE_URL=http://email-service:8083
# Limite total de anexos por e-mail, em bytes.
APP_ANEXOS_LIMITE_TOTAL_BYTES=10485760
# Host do PostgreSQL; use postgres para a instância do Compose.
POSTGRES_HOST=postgres
# Porta publicada no host; os serviços Compose usam a porta interna 5432.
POSTGRES_PORT=5432
# Banco criado na inicialização do PostgreSQL.
POSTGRES_DB=stentio
# Usuário administrativo do PostgreSQL.
POSTGRES_USER=postgres
# Senha administrativa do PostgreSQL; substitua por um valor forte.
POSTGRES_PASSWORD=CHANGE_ME
# Host do MongoDB; use mongodb para a instância do Compose.
MONGO_HOST=mongodb
# Porta interna do MongoDB usada pelos serviços na rede Compose.
MONGO_PORT=27017
# Porta do MongoDB publicada no host.
MONGO_PUBLISHED_PORT=27017
# Usuário administrador do MongoDB.
MONGO_INITDB_ROOT_USERNAME=root
# Senha administrativa do MongoDB; substitua por um valor forte.
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME
# Porta publicada no host para o chatbot; internamente ele usa 8000.
CHATBOT_PORT=8000
# Usuário PostgreSQL somente leitura usado pelo chatbot.
CHATBOT_DB_USER=agent
# Senha do usuário PostgreSQL do chatbot; gere com openssl rand -hex 32.
CHATBOT_DB_PASSWORD=
# Banco MongoDB usado para o histórico do chatbot.
MONGO_DB_NAME=stentio_chatbot
# Chave Groq necessária para gerar respostas do chatbot.
GROQ_API_KEY=
# Algoritmo usado para validar tokens JWT.
JWT_ALGORITHM=HS256
# Porta publicada no host; os serviços Compose usam a porta interna 5672.
RABBITMQ_PORT=5672
# Porta publicada no host para a interface de administração do RabbitMQ.
RABBITMQ_MANAGEMENT_PORT=15672
# Usuário inicial do RabbitMQ, compartilhado pelos serviços.
RABBITMQ_DEFAULT_USER=myuser
# Senha inicial do RabbitMQ; substitua por um valor forte.
RABBITMQ_DEFAULT_PASS=CHANGE_ME
# Host SMTP; use mailhog com o perfil dev ou informe seu servidor SMTP.
SPRING_MAIL_HOST=mailhog
# Porta SMTP do servidor configurado.
SPRING_MAIL_PORT=1025
# Usuário SMTP; deixe vazio quando o servidor não exigir autenticação.
SPRING_MAIL_USERNAME=
# Senha SMTP; deixe vazia quando o servidor não exigir autenticação.
SPRING_MAIL_PASSWORD=
# Ativa autenticação SMTP.
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
# Ativa STARTTLS no SMTP.
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
# Exige STARTTLS quando a conexão SMTP é estabelecida.
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=false
# Porta SMTP publicada no host para o MailHog no perfil dev.
MAILHOG_PORT_SMTP=1025
# Porta web publicada no host para a interface do MailHog no perfil dev.
MAILHOG_PORT=8025
# Tamanho máximo de cada arquivo recebido pelo serviço de importação, em bytes.
MAX_UPLOAD_BYTES=10485760
# Número máximo de linhas processadas em uma importação.
MAX_IMPORT_ROWS=5000
# Número máximo de recursos processados em uma importação.
MAX_IMPORT_RESOURCES=1000
# Origens permitidas no serviço de importação, em formato JSON.
CORS_ALLOWED_ORIGINS=["http://localhost","http://localhost:8080","http://localhost:19006","http://127.0.0.1","http://127.0.0.1:8080"]
# Exibe consultas SQL no log do serviço de importação.
DATABASE_ECHO=false
# Nível mínimo de log do serviço de importação.
LOGGER_LEVEL=INFO
# Token obrigatório para iniciar o perfil deploy do Cloudflare Tunnel.
CLOUDFLARED_TUNNEL_TOKEN=
