# PostgreSQL configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# MongoDB configuration
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_PORT=27017
# RabbitMQ configuration
RABBITMQ_DEFAULT_USER=myuser
RABBITMQ_DEFAULT_PASS=changeme
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -JWT
# Em branco usa o default de dev do application.yaml; em prod, defina uma chave forte
# JWT_SECRET=

# -Seed de admin (dev)
# No Docker: o .env é lido pelo docker compose e repassado ao container (docker compose up -d --build).
# No ./gradlew bootRun: o .env NÃO é lido pelo Spring — exporte no shell/IDE
# (IntelliJ: Run > Edit > Environment variables).
SEED_ADMIN_ENABLED=false
ADMIN_INITIAL_EMAIL=admin@stentio.com
ADMIN_INITIAL_PASSWORD=