# Docker Compose / Spring configuration
SERVER_PORT=8081

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stentio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# MongoDB
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=myuser
RABBITMQ_DEFAULT_PASS=changeme
RABBITMQ_USER=myuser
RABBITMQ_PASS=changeme

# JWT
JWT_SECRET=minha-chave-secreta-super-longa-para-jwt-stentio-2026

# Segurança da aplicação
APP_SECURITY_USER=admin
APP_SECURITY_PASSWORD=admin123

# Cookie de autenticação
# false em dev (HTTP); true em produção (exige HTTPS, senão o browser descarta o cookie)
APP_COOKIE_SECURE=false
# Lax em dev (mesmo site). Em produção cross-site (front e API em domínios diferentes) use None (exige APP_COOKIE_SECURE=true)
APP_COOKIE_SAME_SITE=Lax

# CORS — origins liberadas (lista separada por vírgula). Em dev, inclua o IP de LAN p/ testar de outro device
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:19006

# Seed de admin
SEED_ADMIN_ENABLED=false
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=
