# Configurações compartilhadas pelos serviços
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
APP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8081,http://localhost:8082,http://localhost:19006
APP_CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://[::1]:*

# Auth
SERVER_PORT=8081
APP_SECURITY_USER=admin
APP_SECURITY_PASSWORD=CHANGE_ME
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax
SEED_ADMIN_ENABLED=false
ADMIN_INITIAL_EMAIL=admin@stentio.com
ADMIN_INITIAL_PASSWORD=admin123

# Core
CORE_SERVER_PORT=8082
# Opcional: banco separado para o Core. Vazio usa POSTGRES_DB.
CORE_POSTGRES_DB=
SEED_TEST_DATA_ENABLED=false
ENABLE_DOCS=false
ORCAMENTO_URL_CONSULTA_PUBLICA=http://localhost/orcamento
ORCAMENTO_TOKEN_VALIDADE=PT120H
ORCAMENTO_OUTBOX_ENABLED=true
ORCAMENTO_OUTBOX_INTERVALO_MS=5000
ORCAMENTO_OUTBOX_RETRY_SEGUNDOS=30
ORCAMENTO_OUTBOX_CONFIRM_TIMEOUT_SEGUNDOS=5
APP_ARQUIVOS_DIRETORIO=/app/uploads
APP_ARQUIVOS_EXTENSOES=pdf,doc,docx,odt,rtf,txt,xls,xlsx,ppt,pptx,jpg,jpeg,png
APP_ARQUIVOS_MAXIMO=10
APP_ARQUIVO_TAMANHO_MAXIMO=10MB
APP_REQUISICAO_TAMANHO_MAXIMO=50MB

# Serviço de e-mail
EMAIL_SERVICE_PORT=8083
EMAIL_SERVICE_URL=http://email-service:8083
# Opcional ao executar email-service fora do Compose; em Docker, o URI é montado
# automaticamente a partir de MONGO_INITDB_ROOT_USERNAME/PASSWORD.
SPRING_MONGODB_URI=
APP_ANEXOS_DIRETORIO=/app/uploads
APP_ANEXOS_LIMITE_TOTAL_BYTES=10485760

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=stentio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MongoDB
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=changeme

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DEFAULT_USER=myuser
RABBITMQ_DEFAULT_PASS=changeme
# Credenciais consumidas pelos serviços; por padrão usam RABBITMQ_DEFAULT_*.
RABBITMQ_USER=myuser
RABBITMQ_PASS=changeme

# MailHog (perfil dev do Docker Compose)
MAILHOG_PORT_SMTP=1025
MAILHOG_PORT=8025

# Cloudflare Tunnel: obrigatório somente ao iniciar o profile "deploy".
CLOUDFLARED_TUNNEL_TOKEN=""
