# Url do Auth
# Caso for testar no expo go ou emulador, use o IP da máquina que está rodando a API
EXPO_PUBLIC_API_URL=http://localhost:8081

# URL do Core
# Mesma regra: no Expo Go / emulador, use o IP da máquina (ex: http://192.168.x.x:8082)
EXPO_PUBLIC_CORE_API_URL=http://localhost:8082

# URL do microserviço de e-mail (configuração e teste SMTP)
EXPO_PUBLIC_SMTP_API_URL=http://localhost:8083
