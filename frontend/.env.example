# URLs dos serviços publicados pelo Docker Compose.
# No emulador Android, 10.0.2.2 aponta para o host da máquina.
# Em um celular físico, troque 10.0.2.2 pelo IP da máquina na rede local.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8081
EXPO_PUBLIC_CORE_API_URL=http://10.0.2.2:8082
EXPO_PUBLIC_EMAIL_API_URL=http://10.0.2.2:8083
EXPO_PUBLIC_IMPORT_API_URL=http://10.0.2.2:8123

# O chatbot é publicado diretamente na porta 8000 pelo Docker Compose.
EXPO_PUBLIC_CHATBOT_API_URL=http://10.0.2.2:8000
